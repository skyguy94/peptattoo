// Cloudflare Workers config for deploying Peptattoo as a static site.
//
// There is no Worker script — the app is pure client-side. This config tells
// wrangler to serve everything under ./dist (Vite's build output) as static
// assets from the peptattoo.workers.dev subdomain.
//
// Invoked by the build pipeline via `npx wrangler deploy`. Cloudflare's UI
// runs that command from the "Path" directory configured in the project's
// build settings (currently /client), so paths in this file are relative to
// the client/ directory.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peptattoo",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
